---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404 · Signal Lost" description="The requested resource could not be located.">
  <section class="min-h-[70vh] flex items-center industrial-grid border-b border-surface-variant">
    <div class="max-w-[1600px] mx-auto px-6 md:px-10 py-24 w-full">
      <div class="flex items-center gap-3 mb-6">
        <span class="status-dot"></span>
        <span class="mono-data text-brand-orange uppercase tracking-[0.25em]">
          ERR.0404 // SIGNAL LOST
        </span>
      </div>
      <h1 class="font-sans font-black text-[80px] md:text-[160px] text-brand-orange leading-none tracking-tighter">
        404
      </h1>
      <p class="font-sans text-body-lg md:text-xl text-on-surface-variant mt-6 max-w-xl">
        The requested module is offline or the coordinates are invalid. Re-establishing
        telemetry at the index node.
      </p>
      <div class="flex gap-3 mt-10">
        <a href="/" class="btn-primary">
          Return Home
          <span class="material-symbols-outlined text-base">home</span>
        </a>
        <a href="/solutions" class="btn-ghost">View Solutions</a>
      </div>
    </div>
  </section>
</Layout>
